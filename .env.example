# Lead capture. See docs/GOOGLE-SHEET-SETUP.md
# Both are NEXT_PUBLIC_ because the browser posts directly: they are compiled
# into the page and are readable by anyone. The token is a bot filter, not
# security.
NEXT_PUBLIC_SHEET_ENDPOINT=paste the Web app /exec URL here
NEXT_PUBLIC_SHEET_TOKEN=must match SECRET in Code.gs

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the project's anon / publishable key>
